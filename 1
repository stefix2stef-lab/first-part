-- COLOR PICKER HELPER
-- ============================================================
local function addColorPicker(parent, labelText, flag, defaultColor, defaultTransparency, callback)
    local label = parent:AddLabel(labelText)
    label:AddColorPicker(flag, {
        Default = defaultColor,
        Transparency = defaultTransparency or 0,
    })
    task.defer(function()
        local opt = Options[flag]
        if opt then
            local function apply()
                pcall(function()
                    callback(opt.Value, 1 - (opt.Transparency or 0))
                end)
            end
            opt:OnChanged(apply)
            apply()
        end
    end)
end

