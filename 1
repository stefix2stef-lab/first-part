local function findLimb(character, name)
    local alts = LIMB_ALIASES[name] or {name}
    for _, alt in ipairs(alts) do
        local part = character:FindFirstChild(alt)
        if part and part:IsA("BasePart") then return part end
    end
    for _, alt in ipairs(alts) do
        local part = character:FindFirstChild(alt, true)
        if part and part:IsA("BasePart") then return part end
    end
    return nil
end

local function detectRigType(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if humanoid.RigType == Enum.HumanoidRigType.R15 then return "R15"
        elseif humanoid.RigType == Enum.HumanoidRigType.R6 then return "R6" end
    end
    if character:FindFirstChild("UpperTorso") or character:FindFirstChild("LowerTorso") then
        return "R15"
    end
    return "R6"
end

local function getJointScreenPos(character, jointName)
    local part = findLimb(character, jointName)
    if not part then return nil end
    local worldPos = part.Position
    local camPos   = Camera.CFrame.Position
    local toPoint  = worldPos - camPos
    if toPoint:Dot(Camera.CFrame.LookVector) < 0 then return nil end
    local screenPos = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(screenPos.X, screenPos.Y)
end

local function lerpColor(a, b, t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

