-- ============================================================
-- HELPERS — gradienty
-- ============================================================
local function computeZones(split, blend)
    local p = math.clamp(split / 100, 0, 1)
    local half = (math.clamp(blend, 0, 100) / 100) * 0.5
    local pA = math.clamp(p - half, 0, 1)
    local pB = math.clamp(p + half, 0, 1)
    if pA >= pB then pB = math.min(1, pA + 0.001) end
    if pB <= pA then pA = math.max(0, pB - 0.001) end
    return pA, pB
end

local function applyStrokeStyle(stroke, gradient, a1, a2, rot, c1, c2, split, blend)
    if a1 <= 0 and a2 <= 0 then
        stroke.Transparency = 1
        gradient.Enabled = false
        return
    end
    stroke.Transparency = 0
    stroke.Color = Color3.new(1, 1, 1)
    gradient.Enabled = true
    gradient.Rotation = rot
    local pA, pB = computeZones(split, blend)
    if a1 > 0 and a2 > 0 then
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,  c1),
            ColorSequenceKeypoint.new(pA, c1),
            ColorSequenceKeypoint.new(pB, c2),
            ColorSequenceKeypoint.new(1,  c2),
        })
        gradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,  1 - a1),
            NumberSequenceKeypoint.new(pA, 1 - a1),
            NumberSequenceKeypoint.new(pB, 1 - a2),
            NumberSequenceKeypoint.new(1,  1 - a2),
        })
    elseif a1 > 0 then
        gradient.Color = ColorSequence.new(c1, c1)
        gradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,  1 - a1),
            NumberSequenceKeypoint.new(pA, 1 - a1),
            NumberSequenceKeypoint.new(pB, 1),
            NumberSequenceKeypoint.new(1,  1),
        })
    else
        gradient.Color = ColorSequence.new(c2, c2)
        gradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,  1),
            NumberSequenceKeypoint.new(pA, 1),
            NumberSequenceKeypoint.new(pB, 1 - a2),
            NumberSequenceKeypoint.new(1,  1 - a2),
        })
    end
end

local function applyFillStyle(fill, gradient, visible, a1, a2, rot, c1, c2, split, blend)
    if not visible or (a1 <= 0 and a2 <= 0) then
        fill.Visible = false
        return
    end
    fill.Visible = true
    fill.BackgroundColor3 = Color3.new(1, 1, 1)
    fill.BackgroundTransparency = 0
    gradient.Enabled = true
    gradient.Rotation = rot
    local pA, pB = computeZones(split, blend)
    if a1 > 0 and a2 > 0 then
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,  c1),
            ColorSequenceKeypoint.new(pA, c1),
            ColorSequenceKeypoint.new(pB, c2),
            ColorSequenceKeypoint.new(1,  c2),
        })
        gradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,  1 - a1),
            NumberSequenceKeypoint.new(pA, 1 - a1),
            NumberSequenceKeypoint.new(pB, 1 - a2),
            NumberSequenceKeypoint.new(1,  1 - a2),
        })
    elseif a1 > 0 then
        gradient.Color = ColorSequence.new(c1, c1)
        gradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,  1 - a1),
            NumberSequenceKeypoint.new(pA, 1 - a1),
            NumberSequenceKeypoint.new(pB, 1),
            NumberSequenceKeypoint.new(1,  1),
        })
    else
        gradient.Color = ColorSequence.new(c2, c2)
        gradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,  1),
            NumberSequenceKeypoint.new(pA, 1),
            NumberSequenceKeypoint.new(pB, 1 - a2),
            NumberSequenceKeypoint.new(1,  1 - a2),
        })
    end
end

