local function getCharactersFolder()
    return workspace:FindFirstChild("Characters")
end

local function isCharacterDead(character)
    if not character then return true end
    if character:GetAttribute("Dead") == true then return true end
    local hp = character:GetAttribute("Health")
    if hp ~= nil then return hp <= 0 end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health <= 0 end
    return false
end

-- Zwraca gracza dopasowanego po nazwie (może być nil)
local function getPlayerForCharacter(character)
    if not character then return nil end
    return Players:FindFirstChild(character.Name)
end

local function getHealthInfo(character)
    local hp    = character:GetAttribute("Health")
    local maxHp = character:GetAttribute("MaxHealth")
    if hp == nil then
        local hum = character:FindFirstChildOfClass("Humanoid")
        if hum then
            hp    = hum.Health
            maxHp = hum.MaxHealth
        end
    end
    return hp or 0, maxHp or 100
end

local function isTeammate(player)
    if not player then return false end
    local myTeam = LocalPlayer:GetAttribute("Team")
    local pTeam  = player:GetAttribute("Team")
    return myTeam ~= nil and pTeam ~= nil and myTeam == pTeam
end

local function hasTeam(player)
    if not player then return false end
    return player:GetAttribute("Team") ~= nil
end

local function getWeaponName(player)
    if not player then return nil end
    local ce = player:GetAttribute("CurrentEquipped")
    if type(ce) ~= "string" then return nil end
    local ok, d = pcall(function() return HttpService:JSONDecode(ce) end)
    if ok and type(d) == "table" then
        return d.Name or d.Weapon or d.Skin
    end
    return nil
end

