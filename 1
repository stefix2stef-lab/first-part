end

local function removeBox(character)
    if boxes[character] then
        boxes[character].outline:Destroy()
        boxes[character].fill:Destroy()
        boxes[character].boxOutlineFrame:Destroy()
        boxes[character].nameLabel:Destroy()
        if boxes[character].skeletonLines then
            for _, l in ipairs(boxes[character].skeletonLines) do
                l.frame:Destroy()
            end
        end
        boxes[character] = nil
    end
    if chamsHighlights[character] then
        pcall(function() chamsHighlights[character]:Destroy() end)
        chamsHighlights[character] = nil
    end
end

-- ============================================================
-- BOX COMPUTE
-- ============================================================
local function getBox(character)
    if not character then return nil end

    local hrp  = character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
    local head = character:FindFirstChild("Head")
    if not hrp or not head then return nil end
    if isCharacterDead(character) then return nil end

    local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    if not onScreen then return nil end

    local headPos   = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
    local bottomPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

    local height = math.abs(headPos.Y - bottomPos.Y)
    local width  = height * 0.75

    local x = hrpPos.X - width / 2
    local y = headPos.Y

    return {
        position = Vector2.new(x, y),
        size     = Vector2.new(width, height),
    }
end

-- ============================================================
-- MAIN LOOP
-- ============================================================
local ESP_BIND_NAME = "ESP_Render_Loop"

pcall(function() RunService:UnbindFromRenderStep(ESP_BIND_NAME) end)

RunService:BindToRenderStep(ESP_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function()
    if getgenv().WC_FovEnabled and getgenv().WC_CustomFov then
        Camera.FieldOfView = getgenv().WC_CustomFov
    end

    local folder = workspace:FindFirstChild("Characters")
    if not folder then return end

    local seen = {}

    for _, character in ipairs(folder:GetChildren()) do
        if not character:IsA("Model") then continue end

        local player = getPlayerForCharacter(character)

        if player ~= LocalPlayer then
            seen[character] = true

            if not boxes[character] then createBox(character) end
            local b = boxes[character]
            if b then
                local dead = isCharacterDead(character)

                -- CHAMS
                local chamsActive = false
                if chamsEnabled and not dead then
                    local skip = false
                    if chamsTeamCheck and player and isTeammate(player) then
                        skip = true
                    end

                    if not skip then
                        chamsActive = true

                        local distAlpha = 1
                        if chamsDistanceFade and chamsMaxDistance > 0 then
                            local camPos    = Camera.CFrame.Position
                            local targetPos = character:GetPivot().Position
                            local dist      = (targetPos - camPos).Magnitude
                            distAlpha       = math.clamp(1 - dist / chamsMaxDistance, 0, 1)
                        end

                        local fC = chamsFillColor
                        local oC = chamsOutlineColor
                        local fA = chamsFillAlpha
                        local oA = chamsOutlineAlpha

                        if chamsStyle == "Health" then
                            local hp, maxHp = getHealthInfo(character)
                            local ratio = math.clamp(hp / math.max(maxHp, 1), 0, 1)
                            local hue   = ratio^2 * 0.33
                            fC = Color3.fromHSV(hue, 1, 1)
                            oC = Color3.fromHSV(hue, 0.6, 1)
                        elseif chamsStyle == "Pulse" then
                            local pulse = (math.sin(tick() * chamsPulseSpeed * math.pi * 2) + 1) * 0.5
                            fA = chamsPulseMin + (chamsPulseMax - chamsPulseMin) * pulse
                        end

                        fA = fA * distAlpha
                        oA = oA * distAlpha

                        local hl  = chamsHighlights[character]
                        local hrp = character:FindFirstChild("HumanoidRootPart")

                        b.chamsFrame = (b.chamsFrame or 0) + 1

                        local needsRecreate = (not hl)
                            or hl.Parent ~= character
                            or hl.Adornee ~= character
                            or b.chamsHRP ~= hrp
                            or b.chamsFrame >= CHAMS_RECREATE_INTERVAL

                        if needsRecreate then
                            b.chamsFrame = 0
                            b.chamsHRP   = hrp
                            if hl then pcall(function() hl:Destroy() end) end

                            hl = Instance.new("Highlight")
                            hl.Name      = "ESP_Chams"
                            hl.Adornee   = character
                            hl.DepthMode = (chamsDepthMode == "Occluded")
                                and Enum.HighlightDepthMode.Occluded
                                or  Enum.HighlightDepthMode.AlwaysOnTop
                            hl.FillColor           = fC
                            hl.FillTransparency    = 1 - fA
                            hl.OutlineColor        = oC
                            hl.OutlineTransparency = 1 - oA
                            hl.Enabled = true
                            hl.Parent  = character
                            chamsHighlights[character] = hl
                        else
                            hl.FillColor           = fC
                            hl.FillTransparency    = 1 - fA
                            hl.OutlineColor        = oC
                            hl.OutlineTransparency = 1 - oA
                            hl.DepthMode = (chamsDepthMode == "Occluded")
                                and Enum.HighlightDepthMode.Occluded
                                or  Enum.HighlightDepthMode.AlwaysOnTop
                        end
                    end
                end

                if not chamsActive then
                    local hl = chamsHighlights[character]
                    if hl then
                        pcall(function() hl:Destroy() end)
                        chamsHighlights[character] = nil
                    end
                    b.chamsHRP   = nil
                    b.chamsFrame = 0
                end

                -- SKELETON
                if skeletonEnabled and not dead then
                    local rigType     = detectRigType(character)
                    local connections = (rigType == "R15") and SKELETON_R15 or SKELETON_R6

                    local rotRad = math.rad(skeletonGradientRotation)
                    local dirX   = math.sin(rotRad)
                    local dirY   = math.cos(rotRad)

                    local points = {}
                    local minP, maxP = math.huge, -math.huge
                    for i, conn in ipairs(connections) do
                        local p1 = getJointScreenPos(character, conn[1])
                        local p2 = getJointScreenPos(character, conn[2])
                        points[i] = { p1 = p1, p2 = p2 }
                        for _, p in ipairs({p1, p2}) do
                            if p then
                                local proj = p.X * dirX + p.Y * dirY
                                if proj < minP then minP = proj end
                                if proj > maxP then maxP = proj end
                            end
                        end
                    end
                    if minP == math.huge or maxP == -math.huge then
                        minP, maxP = 0, 1
                    end
                    local rangeP = math.max(maxP - minP, 1)

                    local idx = 1
                    for i, conn in ipairs(connections) do
                        local p1 = points[i].p1
                        local p2 = points[i].p2
                        local ld = b.skeletonLines[idx]
                        if p1 and p2 and ld then
                            local delta  = p2 - p1
                            local length = delta.Magnitude
                            if length > 0.1 then
                                local center = (p1 + p2) * 0.5
                                local angle  = math.deg(math.atan2(delta.Y, delta.X))
                                ld.frame.Position = UDim2.fromOffset(center.X, center.Y)
                                ld.frame.Size = UDim2.fromOffset(length, skeletonThickness)
                                ld.frame.Rotation = angle
                                ld.frame.BackgroundColor3 = Color3.new(1, 1, 1)
                                ld.frame.BackgroundTransparency = 0
                                ld.frame.Visible = true

                                local proj1 = p1.X * dirX + p1.Y * dirY
                                local proj2 = p2.X * dirX + p2.Y * dirY
                                local t1 = (proj1 - minP) / rangeP
                                local t2 = (proj2 - minP) / rangeP

                                local c1 = lerpColor(skeletonColor1, skeletonColor2, t1)
                                local c2 = lerpColor(skeletonColor1, skeletonColor2, t2)
                                local a1 = skeletonAlpha1 + (skeletonAlpha2 - skeletonAlpha1) * t1
                                local a2 = skeletonAlpha1 + (skeletonAlpha2 - skeletonAlpha1) * t2

                                ld.gradient.Color = ColorSequence.new({
                                    ColorSequenceKeypoint.new(0, c1),
                                    ColorSequenceKeypoint.new(1, c2),
                                })
                                ld.gradient.Transparency = NumberSequence.new({
                                    NumberSequenceKeypoint.new(0, 1 - a1),
                                    NumberSequenceKeypoint.new(1, 1 - a2),
                                })
                            else
                                ld.frame.Visible = false
                            end
                        elseif ld then
                            ld.frame.Visible = false
                        end
                        idx = idx + 1
                    end
                    for i = idx, SKELETON_MAX_LINES do
                        if b.skeletonLines[i] then b.skeletonLines[i].frame.Visible = false end
                    end
                else
                    for i = 1, SKELETON_MAX_LINES do
                        if b.skeletonLines[i] then b.skeletonLines[i].frame.Visible = false end
                    end
                end

                if not espEnabled and not nameEnabled then
                    b.outline.Visible = false
                    b.fill.Visible = false
                    b.boxOutlineFrame.Visible = false
                    b.nameLabel.Visible = false
                    continue
                end

                local box = getBox(character)
                if box then
                    local pos  = UDim2.fromOffset(box.position.X, box.position.Y)
                    local size = UDim2.fromOffset(box.size.X, box.size.Y)

                    if espEnabled and boxOutlineEnabled and boxOutlineAlpha > 0 and boxOutlineThickness > 0 then
                        b.boxOutlineFrame.Visible = true
                        b.boxOutlineStroke.Color        = boxOutlineColor
                        b.boxOutlineStroke.Transparency = 1 - boxOutlineAlpha
                        b.boxOutlineStroke.Thickness    = boxOutlineThickness
                        b.boxOutlineFrame.Position = pos
                        b.boxOutlineFrame.Size     = size
                    else
                        b.boxOutlineFrame.Visible = false
                    end

                    if espEnabled then
                        b.outline.Position = pos
                        b.outline.Size     = size
                        b.stroke.Thickness = espThickness
                        b.outline.Visible  = true

                        applyStrokeStyle(b.stroke, b.strokeGradient,
                            outlineAlpha, outlineAlpha2, outlineRotation,
                            outlineColor, outlineColor2, outlineSplit, outlineBlend)

                        b.fill.Position = pos
                        b.fill.Size     = size
                        applyFillStyle(b.fill, b.fillGradient, espFilled,
                            fillAlpha, fillAlpha2, fillRotation,
                            fillColor, fillColor2, fillSplit, fillBlend)
                    else
                        b.outline.Visible = false
                        b.fill.Visible    = false
                    end

                    if nameEnabled then
                        local displayName = player and player.Name or character.Name
                        b.nameLabel.Visible  = true
                        b.nameLabel.Text     = displayName
                        b.nameLabel.TextSize = nameSize
                        b.nameLabel.TextColor3 = nameColor
                        b.nameLabel.Position = UDim2.fromOffset(
                            box.position.X - 50,
                            box.position.Y - nameOffset - nameSize - 4
                        )
                        b.nameLabel.Size = UDim2.fromOffset(box.size.X + 100, nameSize + 4)
                        b.nameStroke.Transparency = nameOutline and 0 or 1
                        b.nameStroke.Color        = nameOutlineColor
                    else
                        b.nameLabel.Visible = false
                    end
                else
                    b.outline.Visible = false
                    b.fill.Visible = false
                    b.boxOutlineFrame.Visible = false
                    b.nameLabel.Visible = false
                end
            end
        end
    end

    -- CLEANUP
    local toRemove = {}
    for char in pairs(boxes) do
        if not seen[char] then table.insert(toRemove, char) end
    end
    for _, char in ipairs(toRemove) do
        removeBox(char)
    end
end)

-- ============================================================
-- COLOR PICKER HELPER (Rayfield — ColorPicker + Opacity slider)
-- ============================================================
local colorState = {}

local function addColorPicker(tab, labelText, flag, defaultColor, defaultTransparency, callback)
    local alpha = 1 - (defaultTransparency or 0)
    colorState[flag] = { color = defaultColor, alpha = alpha }

    callback(defaultColor, alpha)

    tab:CreateColorPicker({
        Name = labelText,
        Color = defaultColor,
        Flag = flag,
        Callback = function(color)
            colorState[flag].color = color
            callback(color, colorState[flag].alpha)
        end,
    })

    tab:CreateSlider({
        Name = labelText .. " Opacity",
        Range = {0, 100},
        Increment = 1,
        Suffix = "%",
        CurrentValue = math.floor(alpha * 100 + 0.5),
        Flag = flag .. "_Opacity",
        Callback = function(value)
            colorState[flag].alpha = value / 100
            callback(colorState[flag].color, value / 100)
        end,
    })
end

local function dropdownValue(option)
    return type(option) == "table" and option[1] or option
end

